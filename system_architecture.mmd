flowchart TB
    subgraph CLIENT["CLIENT LAYER"]
        REACT["React Frontend<br/>(Vite, Port 5174)"]
        LOGIN["Login Page<br/>(Email/Password)"]
        DASHBOARD["Dashboard + Chat UI<br/>(Session-based)"]
    end

    subgraph API["API GATEWAY - FastAPI (Port 8000)"]
        FASTAPI["FastAPI Server<br/>CORS Middleware"]
        AUTH_REG["POST /auth/register"]
        AUTH_LOGIN["POST /auth/login"]
        CHAT_EP["POST /chat"]
        CRUD["GET /accounts<br/>GET /transactions<br/>GET /loans"]
    end

    subgraph SECURITY["SECURITY & GUARDRAILS"]
        JWT["JWT Authentication<br/>HS256 / 30min Expiry / RBAC"]
        PII["PII Masking<br/>Microsoft Presidio<br/>+ Regex Fallback"]
        INPUT["Input Validation<br/>Length Check / Sanitization"]
        AUDIT["Audit Logging<br/>Every Agent Action"]
        BCRYPT["Password Hashing<br/>bcrypt"]
    end

    subgraph AGENTS["AI AGENT LAYER"]
        COORD["Coordinator Agent<br/>Intent Classification"]
        ACC_AGENT["Account Agent<br/>Balance & Details"]
        TXN_AGENT["Transaction Agent<br/>History & Details"]
        LOAN_AGENT["Loan Agent<br/>EMI / Eligibility / Apply"]
    end

    subgraph LLM["LLM PROVIDER"]
        GROQ["Groq Cloud API<br/>Model: openai/gpt-oss-120b<br/>Function Calling / Tool Use"]
    end

    subgraph TOOLS["TOOL & DATA ACCESS LAYER"]
        ACC_TOOLS["Account Tools<br/>get_account_balance"]
        TXN_TOOLS["Transaction Tools<br/>get_recent_transactions<br/>get_user_transactions"]
        LOAN_TOOLS["Loan Tools<br/>get_available_loan_products<br/>calculate_loan_emi<br/>get_user_loans<br/>check_loan_eligibility<br/>apply_for_loan"]
        MEM_TOOLS["Memory Tools<br/>save_memory / get_memory"]
        AUD_TOOLS["Audit Tools<br/>save_audit_log"]
    end

    subgraph DB["DATABASE LAYER - Supabase PostgreSQL"]
        USERS_T[("users")]
        CUSTOMERS_T[("customers")]
        ACCOUNTS_T[("accounts")]
        TRANSACTIONS_T[("transactions")]
        LOANS_T[("loans")]
        LOAN_APPS_T[("loan_applications")]
        CONV_MEM_T[("conversation_memory")]
        AUDIT_T[("audit_logs")]
    end

    REACT --> |"HTTP + JWT"| FASTAPI
    LOGIN --> AUTH_LOGIN
    DASHBOARD --> CHAT_EP

    FASTAPI --> JWT
    FASTAPI --> PII
    FASTAPI --> INPUT
    AUTH_REG --> BCRYPT

    CHAT_EP --> |"Sanitized Message"| COORD
    COORD --> |"ACCOUNT"| ACC_AGENT
    COORD --> |"TRANSACTION"| TXN_AGENT
    COORD --> |"LOAN"| LOAN_AGENT

    ACC_AGENT <--> |"Tool Calls"| GROQ
    TXN_AGENT <--> |"Tool Calls"| GROQ
    LOAN_AGENT <--> |"Tool Calls"| GROQ
    COORD --> |"Classification"| GROQ

    ACC_AGENT --> ACC_TOOLS
    TXN_AGENT --> TXN_TOOLS
    LOAN_AGENT --> LOAN_TOOLS
    CHAT_EP --> MEM_TOOLS
    CHAT_EP --> AUD_TOOLS

    ACC_TOOLS --> |"SQLAlchemy"| ACCOUNTS_T
    TXN_TOOLS --> |"SQLAlchemy"| TRANSACTIONS_T
    LOAN_TOOLS --> LOANS_T
    LOAN_TOOLS --> LOAN_APPS_T
    MEM_TOOLS --> CONV_MEM_T
    AUD_TOOLS --> AUDIT_T
    AUTH_REG --> USERS_T
    AUTH_LOGIN --> USERS_T

    USERS_T --- CUSTOMERS_T
    CUSTOMERS_T --- ACCOUNTS_T
    ACCOUNTS_T --- TRANSACTIONS_T
    CUSTOMERS_T --- LOANS_T
